generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { OWNER MANAGER SALES_ASSOCIATE TECHNICIAN INVENTORY_MANAGER ADMIN }
enum InventoryType { MERCHANDISE LIVESTOCK CORAL PLANT INVERTEBRATE }
enum AppointmentStatus { SCHEDULED COMPLETED CANCELLED RESCHEDULED }
enum TankType { FRESHWATER SALTWATER REEF PLANTED AFRICAN_CICHLID POND OTHER }

model Store {
  id           String        @id @default(cuid())
  name         String
  timezone     String        @default("America/Los_Angeles")
  users        User[]
  customers    Customer[]
  products     Product[]
  vendors      Vendor[]
  sales        Sale[]
  appointments ServiceAppointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model User {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  email     String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([storeId, email])
}

model Customer {
  id                     String   @id @default(cuid())
  storeId                String
  store                  Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  firstName              String
  lastName               String
  phone                   String?
  email                   String?
  preferredContactMethod String?
  notes                   String?
  aquariums               Aquarium[]
  sales                   Sale[]
  appointments            ServiceAppointment[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  @@index([storeId, lastName])
}

model Aquarium {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name            String
  tankType        TankType
  volumeGallons   Decimal? @db.Decimal(10, 2)
  normalServiceDays Int?
  lastServicedAt  DateTime?
  notes           String?
  appointments    ServiceAppointment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Vendor {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@unique([storeId, name])
}

model Product {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vendorId       String?
  vendor         Vendor?       @relation(fields: [vendorId], references: [id])
  type           InventoryType
  name           String
  sku            String
  barcode        String?
  category       String
  cost           Decimal       @db.Decimal(12, 2)
  retailPrice    Decimal       @db.Decimal(12, 2)
  quantityOnHand Decimal       @db.Decimal(12, 2)
  reorderPoint   Decimal?      @db.Decimal(12, 2)
  reorderQuantity Decimal?     @db.Decimal(12, 2)
  receivedAt     DateTime?
  soldAt         DateTime?
  mortalityAt    DateTime?
  saleItems      SaleItem[]
  movements      InventoryMovement[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@unique([storeId, sku])
  @@index([storeId, type, category])
}

model InventoryMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Decimal  @db.Decimal(12, 2)
  reason    String
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
}

model Sale {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  subtotal   Decimal   @db.Decimal(12, 2)
  tax        Decimal   @db.Decimal(12, 2)
  total      Decimal   @db.Decimal(12, 2)
  items      SaleItem[]
  soldAt     DateTime  @default(now())
  @@index([storeId, soldAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)
}

model ServiceAppointment {
  id          String            @id @default(cuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  aquariumId  String?
  aquarium    Aquarium?         @relation(fields: [aquariumId], references: [id])
  technicianId String?
  status      AppointmentStatus @default(SCHEDULED)
  scheduledAt DateTime
  completedAt DateTime?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([storeId, scheduledAt, status])
}
